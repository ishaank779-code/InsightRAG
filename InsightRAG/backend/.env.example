APP_NAME=InsightRAG
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=True

# Google Gemini API Key for Embeddings and Generation (Optional, fallback heuristics enabled)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Vector DB & Storage
VECTOR_STORE_PATH=./vectorstore/index.json
DATA_STORAGE_PATH=./data/sample_documents

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173
